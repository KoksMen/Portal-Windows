<Project>
  <PropertyGroup>
    <!-- Centralized Versioning: Single source of truth for the entire solution -->
    <PortalVersion>1.8.7</PortalVersion>
    <PortalReleaseCodename>Herta</PortalReleaseCodename>

    <Version>$(PortalVersion)</Version>
    <AssemblyVersion>$(PortalVersion).0</AssemblyVersion>
    <FileVersion>$(PortalVersion).0</FileVersion>
    <InformationalVersion>$(PortalVersion)-$(PortalReleaseCodename)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Unified Framework & Runtime Configuration: Target .NET 10 exclusively -->
    <DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == ''">net10.0-windows10.0.19041.0</DefaultTargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
