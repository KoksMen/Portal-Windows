<Window
    x:Class="Portal.Host.LogsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Portal Logs"
    Width="1280"
    Height="860"
    MinWidth="1000"
    MinHeight="680"
    Background="#0a0f1a"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#e5edff" />
        <SolidColorBrush x:Key="TextMuted" Color="#97aed8" />
        <SolidColorBrush x:Key="PanelBg" Color="#0f172a" />
        <SolidColorBrush x:Key="PanelBorder" Color="#2c4470" />
        <SolidColorBrush x:Key="InputBg" Color="#0a1120" />
        <SolidColorBrush x:Key="InputBorder" Color="#365486" />

        <Style x:Key="LogsButtonPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#3f76e0" />
                                    <GradientStop Offset="1" Color="#6d52dd" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogsButtonSecondary" TargetType="Button" BasedOn="{StaticResource LogsButtonPrimary}">
            <Setter Property="Foreground" Value="#dce8ff" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="#1a2842"
                            BorderBrush="#3a578b"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#21365a" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Foreground" Value="#dbe8ff" />
            <Setter Property="Background" Value="#0f1a32" />
            <Setter Property="BorderBrush" Value="#3a5c93" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
        </Style>

        <Style x:Key="LogsFilterChip" TargetType="Button">
            <Setter Property="Foreground" Value="#c5d7fa" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#152136" />
            <Setter Property="BorderBrush" Value="#2d4572" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1e3253" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#456ba8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12"
            Background="#0e1628"
            BorderBrush="#2d4572"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#ecf3ff"
                            Text="Logs Viewer" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="{Binding LogsUpdatedAtText}" />
                    </StackPanel>

                    <DatePicker
                        Grid.Column="1"
                        Width="170"
                        VerticalAlignment="Center"
                        SelectedDate="{Binding SelectedDate}" />

                    <Button
                        Grid.Column="3"
                        MinWidth="98"
                        Command="{Binding RefreshLogsCommand}"
                        Content="Refresh"
                        Style="{StaticResource LogsButtonPrimary}" />

                    <Button
                        Grid.Column="5"
                        MinWidth="98"
                        Command="{Binding CloseWindowCommand}"
                        Content="Close"
                        Style="{StaticResource LogsButtonSecondary}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="260"
                            Height="34"
                            Margin="0,0,12,0"
                            Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="9,0,4,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextMain}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Padding="2,0" />

                            <TextBlock Grid.Column="1"
                                       Text="Search logs..."
                                       Foreground="#62789f"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMuted}" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="All"
                                Command="{Binding SelectFilterCommand}"
                                CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LogsFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="#2563eb" />
                                            <Setter Property="BorderBrush" Value="#60a5fa" />
                                            <Setter Property="Foreground" Value="#ffffff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Errors"
                                Command="{Binding SelectFilterCommand}"
                                CommandParameter="Errors">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LogsFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterErrors}" Value="True">
                                            <Setter Property="Background" Value="#b91c1c" />
                                            <Setter Property="BorderBrush" Value="#f87171" />
                                            <Setter Property="Foreground" Value="#ffffff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Network (WS)"
                                Command="{Binding SelectFilterCommand}"
                                CommandParameter="NetworkWs">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LogsFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterNetwork}" Value="True">
                                            <Setter Property="Background" Value="#0284c7" />
                                            <Setter Property="BorderBrush" Value="#38bdf8" />
                                            <Setter Property="Foreground" Value="#ffffff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Bluetooth (BLE)"
                                Command="{Binding SelectFilterCommand}"
                                CommandParameter="BluetoothBle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LogsFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterBluetooth}" Value="True">
                                            <Setter Property="Background" Value="#7c3aed" />
                                            <Setter Property="BorderBrush" Value="#a78bfa" />
                                            <Setter Property="Foreground" Value="#ffffff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding FilterSummaryText}"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="10"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#d8e7ff"
                        Text="Host Logs" />

                    <TextBox
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#d7e5ff"
                        Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        IsReadOnly="True"
                        Text="{Binding HostLogsText}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="10"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#d8e7ff"
                        Text="Provider Logs" />

                    <TextBox
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#d7e5ff"
                        Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        IsReadOnly="True"
                        Text="{Binding ProviderLogsText}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
