                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock
                                            Foreground="White"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Text="SSL Certificate" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style BasedOn="{StaticResource StatusDot}" TargetType="Ellipse">
                                                        <Setter Property="Width" Value="8" />
                                                        <Setter Property="Height" Value="8" />
                                                        <Setter Property="Margin" Value="0,0,6,0" />
                                                        <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCertOk}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Medium"
                                                VerticalAlignment="Center"
                                                Text="{Binding CertStatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCertOk}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,6,0"
                                            Command="{Binding ShowHostCertificateInfoCommand}"
                                            Content="i"
                                            Style="{StaticResource InfoIconButton}"
                                            ToolTip="Host certificate information" />
                                        <Button
                                            Padding="8,4"
                                            Background="#5a1f28"
                                            Command="{Binding FixCertCommand}"
                                            Content="Regenerate"
                                            FontSize="11"
                                            Foreground="#ffe6ea"
                                            IsEnabled="{Binding IsNotWorkingHealth}"
                                            Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  4. DLL Files  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="12,10"
                                Background="#101726"
                                BorderBrush="#1e2c47"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock
                                            Foreground="White"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Text="DLL Files" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style BasedOn="{StaticResource StatusDot}" TargetType="Ellipse">
                                                        <Setter Property="Width" Value="8" />
                                                        <Setter Property="Height" Value="8" />
                                                        <Setter Property="Margin" Value="0,0,6,0" />
                                                        <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFilesOk}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Medium"
                                                VerticalAlignment="Center"
                                                Text="{Binding FilesStatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFilesOk}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button
                                Margin="0,10,0,0"
                                Command="{Binding StartWizardCommand}"
                                Content="Run Full Setup Wizard"
                                IsEnabled="{Binding IsNotWorkingHealth}"
                                Style="{StaticResource SecondaryButton}" />
                            <Button
                                Margin="0,10,0,0"
                                Background="#331111"
                                Command="{Binding UninstallCommand}"
                                Content="{Binding UninstallBtnText}"
                                Foreground="#ff8888"
                                IsEnabled="{Binding IsNotWorkingSettings}"
                                Style="{StaticResource SecondaryButton}" />
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextMuted}"
                                Text="{Binding IpAddressText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>


                    <Expander
                        Header="Configuration"
                        Style="{StaticResource SettingsSectionExpander}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                Foreground="{StaticResource TextMuted}"
                                Text="Port"
                                Visibility="Collapsed" />
                            <TextBox
                                x:Name="TxtPort"
                                Margin="0,0,0,15"
                                Text="{Binding SettingsPort, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed" />
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                Foreground="{StaticResource TextMuted}"
                                Text="Unlock Mode" />
                            <RadioButton
                                x:Name="RbModeClient"
                                Content="Client-Initiated (Type 1)"
                                GroupName="UnlockMode"
                                IsChecked="{Binding IsModeClient}"
                                Style="{StaticResource ModeCard}"
                                Tag="Phone scans PC's QR code. Standard mode." />
                            <RadioButton
                                x:Name="RbModeHost"
                                Content="Host-Initiated (Type 2)"
                                GroupName="UnlockMode"
                                IsChecked="{Binding IsModeHost}"
                                Style="{StaticResource ModeCard}"
                                Tag="PC requests unlock. Good for remote access." />
                            <RadioButton
                                x:Name="RbModeBoth"
                                Content="Both (Type 3)"
                                GroupName="UnlockMode"
                                IsChecked="{Binding IsModeBoth}"
                                Style="{StaticResource ModeCard}"
                                Tag="Supports both modes simultaneously." />

                            <!-- Host Request Trigger Selector (visible only for Host-Initiated / Both modes) -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Visibility="{Binding ShowHostTriggerSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMuted}"
                                    Text="Auto-Request Trigger" />
                                <RadioButton
                                    Content="Request on click"
                                    GroupName="HostTrigger"
                                    IsChecked="{Binding IsTriggerOnClick}"
                                    Style="{StaticResource ModeCard}"
                                    Tag="Unlock request is sent only when the user clicks the button on the lock screen." />
                                <RadioButton
                                    Content="On click + PC startup"
                                    GroupName="HostTrigger"
                                    IsChecked="{Binding IsTriggerOnClickAndStartup}"
                                    Style="{StaticResource ModeCard}"
                                    Tag="Request on button click AND automatically at PC startup (first logon after boot)." />
                                <RadioButton
                                    Content="On click + any lock screen"
                                    GroupName="HostTrigger"
                                    IsChecked="{Binding IsTriggerOnClickAndAnyLockScreen}"
                                    Style="{StaticResource ModeCard}"
                                    Tag="Request on button click AND automatically whenever the lock screen appears (startup, Win+L, etc.)." />

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="#101728"
                                    BorderBrush="#2c3f66"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#dfe8ff"
                                            Text="Request validity time (minutes)" />
                                        <TextBox
                                            MaxLength="5"
                                            Text="{Binding SettingsHostRequestTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="#8fa2cf"
                                            Text="How long Host waits for device approval. Use 0 to wait until manual cancellation."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border
                                Margin="0,10,0,12"
                                Padding="12"
                                Background="#101728"
                                BorderBrush="#2c3f66"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <CheckBox
                                        IsChecked="{Binding IsDuplicateAccountProtectionEnabled}"
                                        Style="{StaticResource PortalCheckBox}"
                                        Foreground="#e6edff"
                                        Content="Block duplicate account pairing on same transport" />
                                    <CheckBox
                                        Margin="0,8,0,0"
                                        IsChecked="{Binding IsCrossTransportDuplicateProtectionEnabled}"
                                        IsEnabled="{Binding CanUseCrossTransportProtection}"
                                        Style="{StaticResource PortalCheckBox}"
                                        Foreground="#e6edff"
                                        Content="Also block pairing this account on another transport" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="#8fa2cf"
                                        Text="Second option depends on the first one. If the first is off, this one is disabled and turned off."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="#101728"
                                BorderBrush="#2c3f66"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <CheckBox
                                        IsChecked="{Binding IsVpnCompatibilityModeEnabled}"
                                        Style="{StaticResource PortalCheckBox}"
                                        Foreground="#e6edff"
                                        Content="VPN compatibility mode (ignore VPN/virtual adapters)" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="#8fa2cf"
                                        Text="Recommended for stable pairing/restore IP routing when VPN is active."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="Appearance &amp; Styling"
                        Style="{StaticResource SettingsSectionExpander}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                Foreground="{StaticResource TextMuted}"
                                Text="Window Backdrop Material" />

                            <RadioButton
                                Content="Mica (Windows 11)"
                                GroupName="BackdropStyle"
                                IsChecked="{Binding IsBackdropMica}"
                                Style="{StaticResource ModeCard}"
                                Tag="Subtle, dynamic blur sampled from desktop wallpaper." />

                            <RadioButton
                                Content="Acrylic"
                                GroupName="BackdropStyle"
                                IsChecked="{Binding IsBackdropAcrylic}"
                                Style="{StaticResource ModeCard}"
                                Tag="Translucent frosted glass blur material." />

                            <RadioButton
                                Content="Mica Alt (Tabbed)"
                                GroupName="BackdropStyle"
                                IsChecked="{Binding IsBackdropMicaAlt}"
                                Style="{StaticResource ModeCard}"
                                Tag="Deeper, high-contrast desktop wallpaper blur." />

                            <RadioButton
                                Content="Solid Dark (Classic)"
                                GroupName="BackdropStyle"
                                IsChecked="{Binding IsBackdropNone}"
                                Style="{StaticResource ModeCard}"
                                Tag="Opaque dark background. Automatic fallback on Windows 10." />

                            <Border
                                Margin="0,8,0,0"
                                Padding="10"
                                Background="#101728"
                                BorderBrush="#2c3f66"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#8fa2cf"
                                    Text="{Binding BackdropStatusText}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="Backup"
                        Style="{StaticResource SettingsSectionExpander}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="12"
                                Foreground="{StaticResource TextMuted}"
                                Text="Encrypted backup includes config settings, trusted devices and host certificate."
                                TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Background="#1b2c4a"
                                    Command="{Binding OpenCreateBackupDialogCommand}"
                                    Content="Create Backup"
                                    Foreground="#eaf1ff"
                                    Style="{StaticResource SecondaryButton}" />

                                <Button
                                    Grid.Column="2"
                                    Background="#1a3d30"
                                    Command="{Binding OpenRestoreBackupDialogCommand}"
                                    Content="Restore From Backup"
                                    Foreground="#e6fff5"
                                    Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="Diagnostics"
                        Style="{StaticResource SettingsSectionExpander}"
                        Visibility="{Binding ShowDiagnosticsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="12"
                                Foreground="{StaticResource TextMuted}"
                                Text="Troubleshooting tools and diagnostic archive export."
                                TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Background="#1f2d4f"
                                    Command="{Binding OpenLogsWindowCommand}"
                                    Content="View Logs"
                                    Foreground="#e3ecff"
                                    Style="{StaticResource SecondaryButton}" />

                                <Button
                                    Grid.Column="2"
                                    Background="#1f3b2f"
                                    Command="{Binding ExportDiagnosticReportCommand}"
                                    Content="Export Diagnostic Report"
                                    Foreground="#e6fff5"
                                    Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="Updates"
                        Style="{StaticResource SettingsSectionExpander}"
                        Visibility="{Binding ShowUpdatesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="#9fa8c4"
                                Text="{Binding UpdateCurrentVersionText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#9fa8c4"
                                Text="{Binding UpdateLastInstalledText}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,14,0,0">
                                <Button
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Content="Check update"
                                    IsEnabled="{Binding IsUpdateOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource UpdateHeroButton}" />
                            </Grid>

                            <CheckBox
                                Margin="0,12,0,0"
                                IsChecked="{Binding IsAutoUpdateChecksEnabled}"
                                Style="{StaticResource PortalCheckBox}"
                                Content="Enable automatic update checks" />
                        </StackPanel>
                    </Expander>

                    <!--  App Info  -->
                    <StackPanel Margin="0,12,0,20" HorizontalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="#444455"
                            Text="{Binding AppVersion, StringFormat='Portal {0}'}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="30,16,30,24"
                Background="#101523"
                BorderBrush="#232c43"
                BorderThickness="0,1,0,0">
                <Button
                    Command="{Binding SaveSettingsCommand}"
                    Content="{Binding SaveConfigBtnText}"
                    IsEnabled="{Binding IsNotWorkingSettings}"
                    Style="{StaticResource PrimaryButton}" />
            </Border>
        </Grid>

        <Grid
            x:Name="UpdateOverlay"
            Background="#E6050508"
            Visibility="{Binding ShowUpdateWizard, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="500"
                MaxWidth="500"
                MaxHeight="620"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#13192a"
                BorderBrush="#315080"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="#f6f9ff"
                            Text="Update Wizard" />

                        <Button
                            Grid.Column="1"
                            Command="{Binding CloseUpdateWizardCommand}"
                            Content="×"
                            IsEnabled="{Binding CanCloseUpdateWizard}"
                            Style="{StaticResource UpdateCloseButton}" />
                    </Grid>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="14"
                        Foreground="#c8d9ff"
                        Text="{Binding UpdateAvailableVersionText}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#f4f7ff"
                        Text="{Binding UpdateStatusTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#b6c7ea"
                        Text="{Binding UpdateStatusMessage}"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        Margin="0,18,0,0"
                        IsIndeterminate="True"
                        Style="{StaticResource UpdateProgressBar}"
                        Visibility="{Binding ShowIndeterminateProgressBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ProgressBar
                        Margin="0,10,0,0"
                        Maximum="100"
                        Style="{StaticResource UpdateProgressBar}"
                        Value="{Binding UpdateProgressPercent}"
                        Visibility="{Binding ShowDeterminateProgressBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#8dc5ff"
                        Text="{Binding UpdateProgressPercent, StringFormat='Progress: {0:0.0}%'}"
                        Visibility="{Binding ShowDeterminateProgressBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#0f1728"
                        BorderBrush="#28436a"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding ShowUpdateTransferBlock, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="#7fa3d8"
                                Text="File" />
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Foreground="#e1ebff"
                                Text="{Binding UpdateFileName}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,12,0"
                                VerticalAlignment="Center"
                                Foreground="#7fa3d8"
                                Text="Transfer" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                FontFamily="Consolas"
                                Foreground="#e1ebff"
                                Text="{Binding UpdateTransferText}" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,12,12,0"
                                VerticalAlignment="Center"
                                Foreground="#7fa3d8"
                                Text="Speed" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                FontFamily="Consolas"
                                Foreground="#e1ebff"
                                Text="{Binding UpdateSpeedText}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Margin="0,14,0,0"
                        Foreground="{StaticResource TextMuted}"
                        Text="{Binding UpdateProgressHintText}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            Padding="20,10"
                            Command="{Binding InstallUpdateCommand}"
                            Content="{Binding InstallUpdateButtonText}"
                            IsEnabled="{Binding CanInstallUpdate}"
                            Style="{StaticResource UpdateHeroButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="AboutOverlay"
            Background="#DE05070F"
            Visibility="{Binding ShowAboutDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420" MaxWidth="420" MaxHeight="720" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#16141B" BorderBrush="#2C2A31" BorderThickness="1" CornerRadius="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#F4F1F8" Text="Settings" />
                                <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#B3AFC0" Text="About app" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseAboutCommand}" Content="×" Style="{StaticResource UpdateCloseButton}" />
                        </Grid>

                        <Border Padding="10" Background="#2C2931" BorderBrush="#34303B" BorderThickness="1" CornerRadius="22">
                            <StackPanel>
                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutTermsUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F1EEF7" Text="&#xE71D;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Terms of Use" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutTermsDisplay}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutPrivacyUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F1EEF7" Text="&#xE72E;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Privacy Policy" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutPrivacyDisplay}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutMobileClientUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F1EEF7" Text="&#xE896;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Download mobile app" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutMobileClientDisplay}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutAndroidSourceUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#F1EEF7" Text="&lt;/&gt;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Source Code of android app" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutAndroidSourceDisplay}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutDesktopSourceUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#F1EEF7" Text="&lt;/&gt;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Source Code of PC client" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutDesktopSourceDisplay}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutAndroidDeveloperProfileUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid Width="42" Height="42" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <Border Background="#201D26" BorderBrush="#5A5366" BorderThickness="1" CornerRadius="14" />
                                            <Image
                                                Margin="1"
                                                Loaded="AvatarImage_Loaded"
                                                SizeChanged="AvatarImage_SizeChanged"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                SnapsToDevicePixels="True"
                                                Source="{Binding AboutAndroidDeveloperAvatarImage}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="Android app developer" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutAndroidDeveloperHandle}" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding AboutDesktopDeveloperProfileUrl}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid Width="42" Height="42" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <Border Background="#201D26" BorderBrush="#5A5366" BorderThickness="1" CornerRadius="14" />
                                            <Image
                                                Margin="1"
                                                Loaded="AvatarImage_Loaded"
                                                SizeChanged="AvatarImage_SizeChanged"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                SnapsToDevicePixels="True"
                                                Source="{Binding AboutDesktopDeveloperAvatarImage}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="14" Foreground="#F6F3FA" Text="PC client developer" /><TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AboutDesktopDeveloperHandle}" /></StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A8A2B2" Text="&#xE72A;" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding RegisterAboutVersionTapCommand}" Style="{StaticResource AboutRowButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#3A3740" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F1EEF7" Text="&#xE946;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" Foreground="#F6F3FA" Text="App Version" />
                                            <TextBlock FontSize="12" Foreground="#B7B0C3" Text="{Binding AppReleaseVersion}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            x:Name="ModalOverlay"
            Background="#E6050508"
            Visibility="{Binding ShowWizard, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="430"
                MaxHeight="720"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1a1a24"
                BorderBrush="#333344"
                BorderThickness="1"
                CornerRadius="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,0">
                    <StackPanel x:Name="StepProgress" Visibility="{Binding StepProgressVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Configuring..." />
                        <ProgressBar
                            x:Name="WizProgress"
                            Margin="0,0,0,15"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="Blue"
                            IsIndeterminate="{Binding WizProgressIsIndeterminate}"
                            Style="{StaticResource SpinnerStyle}" />
                        <TextBlock
                            x:Name="WizStatusText"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMuted}"
                            Text="{Binding WizStatusText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,30,0,0"
                            Padding="20,10"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Command="{Binding CloseWizardCommand}"
                            Content="Cancel Setup"
                            Foreground="White"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <StackPanel x:Name="StepCreds" Visibility="{Binding StepCredsVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="PC Login Details" />
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="Required for Windows to unlock." />
                        <Border
                            Padding="12"
                            Background="#101525"
                            BorderBrush="#2b3f6c"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding WizShowAutoAccountSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="11"
                                    Foreground="{StaticResource TextMuted}"
                                    Text="Choose Windows Account" />
                                <ComboBox
                                    x:Name="InputAccount"
                                    ItemTemplate="{StaticResource LocalAccountOptionTemplate}"
                                    ItemsSource="{Binding AvailableLocalAccounts}"
                                    SelectedItem="{Binding SelectedLocalAccount}"
                                    Style="{StaticResource PortalComboBox}"
                                    SelectionChanged="InputAccount_SelectionChanged" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="11"
                                    Foreground="#8fa2cf"
                                    Text="{Binding SelectedLocalAccount.DisplayName, FallbackValue=Select account from list}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,10,0,5"
                            FontSize="11"
                            Foreground="{StaticResource TextMuted}"
                            Text="Password" />
                        <PasswordBox x:Name="InputPass" />

                        <!--  Device Name (Visible only when Editing)  -->
                        <TextBlock
                            Margin="0,10,0,5"
                            FontSize="11"
                            Foreground="{StaticResource TextMuted}"
                            Text="Device Name"
                            Visibility="{Binding WizShowDeviceNameEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBox
                            x:Name="InputEditDeviceName"
                            Text="{Binding WizDeviceName, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding WizShowDeviceNameEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Command="{Binding StepCredsBackCommand}"
                                Content="Back"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding WizHideDeviceNameEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Grid.Column="0"
                                Command="{Binding CancelEditCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding WizShowDeviceNameEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding CredsNextCommand}"
                                CommandParameter="{Binding ElementName=InputPass}"
                                Content="{Binding WizCredsNextText}"
                                Style="{StaticResource PrimaryButton}" />
                        </Grid>

                        <Button
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseWizardCommand}"
                            Content="Cancel Setup"
                            Foreground="{StaticResource TextMuted}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding WizHideDeviceNameEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!--  Transport Selection Step  -->
                    <StackPanel x:Name="StepTransport" Visibility="{Binding StepTransportVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Choose Pairing Method" />
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="Select how you want to pair with the device." />

                        <RadioButton
                            x:Name="RbTransportNetwork"
                            Content="🌐 Network (Wi-Fi / LAN)"
                            GroupName="Transport"
                            IsChecked="{Binding IsTransTcp}"
                            Style="{StaticResource ModeCard}"
                            Tag="Pair over local network. Both devices must be on the same Wi-Fi/LAN." />
                        <RadioButton
                            x:Name="RbTransportBluetooth"
                            Content="📶 Bluetooth"
                            GroupName="Transport"
                            IsChecked="{Binding IsTransBt}"
                            Style="{StaticResource ModeCard}"
                            Tag="Pair over Bluetooth. No Wi-Fi required. Devices must be in range." />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Command="{Binding StepTransportBackCommand}"
                                Content="Back"
                                Style="{StaticResource SecondaryButton}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding TransportNextCommand}"
                                Content="Next →"
                                Style="{StaticResource PrimaryButton}" />
                        </Grid>

                        <Button
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseWizardCommand}"
                            Content="Cancel Setup"
                            Foreground="{StaticResource TextMuted}"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <StackPanel x:Name="StepPairing" Visibility="{Binding StepPairingVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Connect Phone" />
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="Enter this code in the mobile app:" />
                        <Border
                            Margin="0,0,0,20"
                            Padding="15"
                            Background="#000"
                            BorderBrush="#333"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="WizPairCode"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding WizPairCode}" />
                                <Button
                                    Margin="15,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding CopyCodeCommand}"
                                    Content="📋"
                                    Cursor="Hand"
                                    FontSize="20"
                                    Foreground="#8888a0"
                                    ToolTip="Copy Code" />
                            </StackPanel>
                        </Border>
                        <ProgressBar
                            Margin="20,0,20,10"
                            IsIndeterminate="True"
                            Style="{StaticResource SpinnerStyle}" />
                        <TextBlock
                            x:Name="WizPairInfo"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TextMuted}"
                            Text="{Binding WizPairInfo}" />

                        <TextBlock
                            x:Name="WizExpiresInfo"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="#664444"
                            Text="{Binding WizExpiresInfo}" />

                        <!--  Network info panel  -->
                        <StackPanel
                            x:Name="PanelNetworkInfo"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Vertical"
                            Visibility="{Binding WizShowNetworkInfo, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!--  IP Selection -->
                            <Grid Width="330" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="252" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Padding="10,5"
                                    Background="#111"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            Foreground="#88a"
                                            Text="IP Interface:" />
                                        <ComboBox
                                            ItemTemplate="{StaticResource NetworkIpOptionTemplate}"
                                            MinHeight="52"
                                            FontSize="12"
                                            ItemsSource="{Binding AvailableLocalIps}"
                                            SelectedItem="{Binding SelectedPairIp}"
                                            Style="{StaticResource PortalComboBox}"
                                            SelectionChanged="InputPairIp_SelectionChanged" />
                                    </StackPanel>
                                </Border>
                                <Button
                                    x:Name="BtnCopyIp"
                                    Grid.Column="2"
                                    Padding="10,0"
                                    Click="BtnCopyIp_Click"
                                    Content="📋"
                                    FontSize="16"
                                    ToolTip="Copy IP"
                                    Style="{StaticResource SecondaryButton}" />
                            </Grid>

                            <!--  Port Display  -->
                            <Grid Width="330">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="252" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Padding="10,5"
                                    Background="#111"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#88a"
                                            Text="Port: " />
                                        <TextBlock
                                            x:Name="WizPortOnly"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="#eee"
                                            Text="{Binding WizPortOnly}" />
                                    </StackPanel>
                                </Border>
                                <Button
                                    x:Name="BtnCopyPort"
                                    Grid.Column="2"
                                    Padding="10,0"
                                    Click="BtnCopyPort_Click"
                                    Content="📋"
                                    FontSize="16"
                                    ToolTip="Copy Port"
                                    Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            x:Name="PanelBluetoothInfo"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding WizShowBluetoothInfo, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <Border
                                    Width="260"
                                    Padding="10,5"
                                    Background="#111"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#88a"
                                            Text="BT: " />
                                        <TextBlock
                                            x:Name="WizBtAddress"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="#eee"
                                            Text="{Binding WizBtAddress}" />
                                    </StackPanel>
                                </Border>
                                <Button
                                    x:Name="BtnCopyBt"
                                    Margin="10,0,0,0"
                                    Padding="10,0"
                                    Click="BtnCopyBt_Click"
                                    Content="📋"
                                    FontSize="16"
                                    ToolTip="Copy Bluetooth address"
                                    Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="QrCodeBorder"
                            Margin="0,12,0,0"
                            Padding="8"
                            HorizontalAlignment="Center"
                            Background="White"
                            CornerRadius="8"
                            Visibility="{Binding WizShowQrCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image
                                x:Name="QrCodeImage"
                                Width="144"
                                Height="144"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding WizQrCodeImage}" />
                        </Border>

                        <StackPanel
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">

                            <Button
                                Height="35"
                                Margin="0,0,10,0"
                                Command="{Binding StepPairingBackCommand}"
                                Content="← Back"
                                FontSize="12"
                                Style="{StaticResource SecondaryButton}" />

                            <Button
                                Height="35"
                                Command="{Binding RefreshCodeCommand}"
                                Content="↻ Refresh Code"
                                FontSize="12"
                                Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseWizardCommand}"
                            Content="Cancel Setup"
                            Foreground="{StaticResource TextMuted}"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <StackPanel x:Name="StepNameDevice" Visibility="{Binding StepNameDeviceVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Name Device" />
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="Give this device a friendly name." />

                        <TextBox
                            x:Name="InputDeviceName"
                            Margin="0,0,0,20"
                            Text="{Binding WizDeviceName, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Command="{Binding NameDeviceNextCommand}"
                            Content="Save &amp; Finish"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>

                    <StackPanel x:Name="StepSuccess" Visibility="{Binding StepSuccessVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="24"
                            Text="✅" />
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Success!" />
                        <Button
                            Command="{Binding CloseWizardCommand}"
                            Content="Close"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>

                    <StackPanel x:Name="StepError" Visibility="{Binding StepErrorVis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="24"
                            Text="❌" />
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#ff5555"
                            Text="Error" />
                        <TextBlock
                            x:Name="WizErrorText"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Text="{Binding WizErrorText}"
                            TextWrapping="Wrap" />
                        <Button
                            Command="{Binding CloseWizardCommand}"
                            Content="Close"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            x:Name="BusyOverlay"
            Background="#D9090A12"
            Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="360"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#14141e"
                BorderBrush="#355ca9"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding BusyOperationTitle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Margin="24,18,24,14"
                        IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource SpinnerStyle}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyOperationResultVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#d9e2ff"
                        Text="{Binding BusyOperationStatus}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextMuted}"
                        Text="{Binding BusyOperationHintText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyOperationResultVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        Margin="0,18,0,0"
                        Background="#331111"
                        Command="{Binding CancelBusyOperationCommand}"
                        Content="{Binding BusyCancelButtonText}"
                        Foreground="#ffb0b0"
                        IsEnabled="{Binding CanCancelBusyOperation}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyOperationCancelable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusyOperationResultVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="11"
                        Foreground="#caa3a3"
                        Text="Cancelling can interrupt configuration and may require manual recovery or reinstall."
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyOperationCancelable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusyOperationResultVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        Margin="0,18,0,0"
                        Command="{Binding AcknowledgeBusyResultCommand}"
                        Content="{Binding BusyResultButtonText}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyOperationResultVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="CreateBackupOverlay"
            Background="#CC050913"
            Visibility="{Binding ShowCreateBackupDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="440"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#101626"
                BorderBrush="#2b446b"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#dce7ff"
                        Text="Create Backup" />
                    <TextBlock
                        Margin="0,8,0,14"
                        FontSize="12"
                        Foreground="#97acd8"
                        Text="Backup includes config settings, trusted devices and host server certificate."
                        TextWrapping="Wrap" />

                    <TextBlock FontSize="12" Foreground="#c9d8ff" Text="Password" />
                    <PasswordBox
                        x:Name="BackupPasswordBox"
                        Margin="0,6,0,10"
                        ToolTip="Enter backup encryption password" />

                    <TextBlock FontSize="12" Foreground="#c9d8ff" Text="Confirm Password" />
                    <PasswordBox
                        x:Name="BackupPasswordConfirmBox"
                        Margin="0,6,0,14"
                        ToolTip="Repeat password" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding CloseCreateBackupDialogCommand}"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Background="#1b2c4a"
                            Click="BtnCreateBackup_Click"
                            Content="Create Backup"
                            Foreground="#eaf1ff"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="RestoreBackupOverlay"
            Background="#CC07110D"
            Visibility="{Binding ShowRestoreBackupDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="460"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#102019"
                BorderBrush="#2d5c4a"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#d8ffed"
                        Text="Restore From Backup" />
                    <TextBlock
                        Margin="0,8,0,14"
                        FontSize="12"
                        Foreground="#9ad0ba"
                        Text="Restore replaces current config settings, trusted devices and host server certificate."
                        TextWrapping="Wrap" />

                    <TextBlock FontSize="12" Foreground="#c9f0dd" Text="Backup File" />
                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="10,8"
                            Background="#0f1b16"
                            BorderBrush="#355e4d"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="#b7e5d1"
                                Text="{Binding RestoreBackupFileText}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Button
                            Grid.Column="1"
                            Background="#17352a"
                            Command="{Binding SelectRestoreBackupFileCommand}"
                            Content="Browse"
                            Foreground="#e6fff5"
                            Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <TextBlock FontSize="12" Foreground="#c9f0dd" Text="Password" />
                    <PasswordBox
                        x:Name="RestoreBackupPasswordBox"
                        Margin="0,6,0,14"
                        ToolTip="Enter backup password" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding CloseRestoreBackupDialogCommand}"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Background="#1a3d30"
                            Click="BtnRestoreBackup_Click"
                            Content="Restore"
                            Foreground="#e6fff5"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="CertificateInfoOverlay"
            Background="#CC08101A"
            Visibility="{Binding ShowCertificateInfoDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="500"
                MaxWidth="500"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#111827"
                BorderBrush="#35527e"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#edf4ff"
                        Text="{Binding CertificateInfoTitle}" />
                    <Border
                        Margin="0,14,0,10"
                        Padding="14,12"
                        Background="#162133"
                        BorderBrush="#2e486f"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#eef4ff"
                                Text="{Binding CertificateInfoSummary}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="13"
                                Foreground="#c8d8f5"
                                Text="{Binding CertificateInfoDetails}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,0,0,18"
                        Padding="14,12"
                        Background="#0f1726"
                        BorderBrush="#35527e"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#93abd4"
                                Text="Certificate SHA-256" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="#e4eeff"
                                LineHeight="20"
                                Text="{Binding CertificateInfoHash}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button
                        Width="110"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCertificateInfoCommand}"
                        Content="Close"
                        Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Background="#D908101C"
            Panel.ZIndex="35"
            Visibility="{Binding ShowActivityDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                MinWidth="360"
                MaxWidth="620"
                MaxHeight="680"
                Margin="24"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#10192B"
                BorderBrush="#3B5E99"
                BorderThickness="1"
                CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#F1F6FF" Text="✨ Recent activity" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9BB0D7" Text="{Binding ActivitySummaryText}" />
                        </StackPanel>
                        <Button
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding CloseActivityCommand}"
                            Content="×"
                            FontSize="20"
                            ToolTip="Close activity"
                            Style="{StaticResource InfoIconButton}" />
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="11"
                        Background="#14223A"
                        BorderBrush="#29466F"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock FontSize="11" Foreground="#BDD1F4" Text="Activity helps you understand pairing, unlocks and network recovery. It never includes passwords, IP addresses or certificate data." TextWrapping="Wrap" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="10"
                        Background="#0C1628"
                        BorderBrush="#263E65"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="2,0,0,5" FontSize="10" FontWeight="SemiBold" Foreground="#8FAAD5" Text="SHOW" />
                                <ComboBox ItemsSource="{Binding ActivityFilterOptions}" SelectedItem="{Binding SelectedActivityFilter}" Style="{StaticResource PortalComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="2,0,0,5" FontSize="10" FontWeight="SemiBold" Foreground="#8FAAD5" Text="ORDER" />
                                <ComboBox ItemsSource="{Binding ActivitySortOptions}" SelectedItem="{Binding SelectedActivitySort}" Style="{StaticResource PortalComboBox}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#8FAAD5" Text="FROM DATE" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBox Width="38" ToolTip="Day" Text="{Binding ActivityFromDay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ActivityDateInput}" />
                                    <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="#6F8FC5" Text="/" />
                                    <TextBox Width="38" ToolTip="Month" Text="{Binding ActivityFromMonth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ActivityDateInput}" />
                                    <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="#6F8FC5" Text="/" />
                                    <TextBox Width="58" ToolTip="Year" Text="{Binding ActivityFromYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ActivityDateInput}" />
                                </StackPanel>
                                <Button Grid.Column="4" Width="34" Height="34" Command="{Binding RefreshActivityCommand}" Content="↻" FontSize="17" ToolTip="Refresh activity" Style="{StaticResource InfoIconButton}" />
                                <Button Grid.Column="6" MinWidth="72" Command="{Binding ClearActivityFiltersCommand}" Content="Reset" FontSize="11" Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{Binding BackgroundColor}"
                                        BorderBrush="{Binding AccentColor}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top" FontFamily="Segoe UI Emoji" FontSize="19" Foreground="#DDEAFF" Text="{Binding Icon}" />
                                            <StackPanel Grid.Column="1" Margin="2,0,8,0">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#F2F6FF" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#B6C7E5" Text="{Binding Details}" TextWrapping="Wrap" />
                                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                    <Border
                                                        Margin="0,0,6,0"
                                                        Padding="7,3"
                                                        Background="#183760"
                                                        BorderBrush="#3B70B5"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Visibility="{Binding HasDeviceBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#D8E9FF" Text="{Binding DeviceBadge}" />
                                                    </Border>
                                                    <Border
                                                        Margin="0,0,6,0"
                                                        Padding="7,3"
                                                        Background="#173B2A"
                                                        BorderBrush="#39825B"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Visibility="{Binding HasTransportBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#D9FFE7" Text="{Binding TransportBadge}" />
                                                    </Border>
                                                    <Border
                                                        Padding="7,3"
                                                        Background="#263047"
                                                        BorderBrush="#53617E"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#DDE6FA" Text="{Binding TimeBadge}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button
                        Grid.Row="4"
                        Width="110"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseActivityCommand}"
                        Content="Close"
                        Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!--  NOTIFICATION OVERLAY  -->
        <Grid
            x:Name="NotificationOverlay"
            Background="#BF050510"
            Grid.RowSpan="2"
            Panel.ZIndex="40"
            Visibility="Collapsed">
            <Border
                Width="320"
                Padding="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#ff007a"
                BorderThickness="1"
                CornerRadius="16">
                <Border.Background>
                    <SolidColorBrush Opacity="0.9" Color="#141424" />
                </Border.Background>

                <StackPanel Margin="20">
                    <TextBlock
                        x:Name="NotifyTitle"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Notification" />
                    <TextBlock
                        x:Name="NotifyMessage"
                        MaxHeight="200"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource TextMuted}"
                        Text="Message goes here..."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!--  Buttons for Actions  -->
                    <StackPanel
                        x:Name="NotifyActions"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Visible">
                        <Button
                            x:Name="BtnNotifyYes"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="OnNotifyYes"
                            Content="YES"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            x:Name="BtnNotifyNo"
                            Width="100"
                            Click="OnNotifyNo"
                            Content="NO"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <!--  Button for Verify/OK  -->
                    <Button
                        x:Name="BtnNotifyOk"
                        Width="100"
                        HorizontalAlignment="Center"
                        Click="OnNotifyOk"
                        Content="OK"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>

