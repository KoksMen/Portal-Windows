<Window
    x:Class="Portal.Host.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Portal.Host.Converters"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Portal Manager"
    Width="540"
    Height="760"
    MinWidth="480"
    MinHeight="560"
    AllowsTransparency="False"
    Background="Transparent"
    Closing="Window_Closing"
    Icon="/Assets/portal-icon.png"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="CanResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="AccentBlue">#3864dc</Color>
        <Color x:Key="AccentPurple">#9850e6</Color>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
        <SolidColorBrush x:Key="TextMain" Color="#e0e0e8" />
        <SolidColorBrush x:Key="TextMuted" Color="#8888a0" />
        <SolidColorBrush x:Key="InputBg" Color="#14141e" />
        <SolidColorBrush x:Key="CardBg" Color="#14141e" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333344" />
        <SolidColorBrush x:Key="GreenBrush" Color="#4cd964" />
        <SolidColorBrush x:Key="RedBrush" Color="#ff5555" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#d9e2ff" />
            <Setter Property="Background" Value="#111a31" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#355ca9" />
                                <Setter Property="Foreground" Value="#f5f9ff" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4676d1" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#eef3ff" />
            <Setter Property="Background" Value="#101728" />
            <Setter Property="BorderBrush" Value="#37589f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PortalComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ToggleButton
                                    Style="{StaticResource PortalComboToggle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ClickMode="Press"
                                    Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <ContentPresenter
                                            Margin="10,4,30,4"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            TextElement.Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="#9bb8ff"
                                            Text="▼" />
                                    </Grid>
                                </ToggleButton>
                            </Border>

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom">
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="8"
                                    Background="#101728"
                                    BorderBrush="#3b5ea7"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#4f77cf" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6b95f7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityDatePicker" TargetType="DatePicker">
            <Setter Property="Foreground" Value="#EEF3FF" />
            <Setter Property="Background" Value="#101728" />
            <Setter Property="BorderBrush" Value="#37589F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox
                                x:Name="PART_TextBox"
                                Padding="8,6"
                                VerticalContentAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0">
                                <DatePickerTextBox.Style>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                    <Grid>
                                                        <Border
                                                            x:Name="InputBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalContentAlignment="Center" />
                                                        </Border>
                                                        <TextBlock
                                                            x:Name="Placeholder"
                                                            Margin="{TemplateBinding Padding}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Foreground="#9CB4D8"
                                                            Text="Choose date"
                                                            Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="#71A1FF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePickerTextBox.Style>
                                    </DatePickerTextBox>
                                    <Button
                                x:Name="PART_Button"
                                Grid.Column="1"
                                Focusable="False"
                                Background="#19345E"
                                BorderThickness="0"
                                ToolTip="Choose date">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#BFD7FF" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False">
                                <Popup.Resources>
                                    <Style x:Key="ActivityCalendarDayButton" TargetType="CalendarDayButton">
                                        <Setter Property="Foreground" Value="#DDE9FF" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="3" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CalendarDayButton">
                                                    <Border x:Name="DayBorder" Margin="1" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsToday" Value="True">
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#6B95F7" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#3567CC" />
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#76A8FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsInactive" Value="True">
                                                            <Setter Property="Foreground" Value="#6E82A4" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#1F3966" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ActivityCalendarButton" TargetType="CalendarButton">
                                        <Setter Property="Foreground" Value="#DDE9FF" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CalendarButton">
                                                    <Border x:Name="CalendarButtonBorder" Margin="2" Padding="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CalendarButtonBorder" Property="Background" Value="#1F3966" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ActivityCalendarNavigationButton" TargetType="Button">
                                        <Setter Property="Foreground" Value="#CFE0FF" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="NavigationButtonBorder" Padding="6" Background="{TemplateBinding Background}" CornerRadius="7">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NavigationButtonBorder" Property="Background" Value="#1F3966" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="NavigationButtonBorder" Property="Background" Value="#3567CC" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ActivityCalendarHeaderButton" TargetType="Button" BasedOn="{StaticResource ActivityCalendarNavigationButton}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="13" />
                                    </Style>
                                    <Style x:Key="ActivityCalendarItem" TargetType="CalendarItem">
                                        <Setter Property="Background" Value="#101728" />
                                        <Setter Property="Foreground" Value="#EEF3FF" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CalendarItem">
                                                    <Grid x:Name="PART_Root">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="42" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="4,4,4,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="34" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="PART_PreviousButton" Style="{StaticResource ActivityCalendarNavigationButton}" Content="‹" FontSize="22" />
                                                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource ActivityCalendarHeaderButton}" />
                                                            <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource ActivityCalendarNavigationButton}" Content="›" FontSize="22" />
                                                        </Grid>
                                                        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="4,0,4,4" KeyboardNavigation.TabNavigation="Once">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="26" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                                                            </Grid.RowDefinitions>
                                                        </Grid>
                                                        <Grid x:Name="PART_YearView" Grid.Row="1" Margin="4,0,4,4" Visibility="Hidden" KeyboardNavigation.TabNavigation="Once">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                        </Grid>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                                                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                                                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                    <ControlTemplate.Resources>
                                                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#91ADD9" Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ControlTemplate.Resources>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ActivityCalendar" TargetType="Calendar">
                                        <Setter Property="Background" Value="#101728" />
                                        <Setter Property="Foreground" Value="#EEF3FF" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ActivityCalendarDayButton}" />
                                        <Setter Property="CalendarButtonStyle" Value="{StaticResource ActivityCalendarButton}" />
                                        <Setter Property="CalendarItemStyle" Value="{StaticResource ActivityCalendarItem}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Calendar">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Popup.Resources>
                                <Border Margin="0,6,0,0" Padding="8" Background="#101728" BorderBrush="#37589F" BorderThickness="1" CornerRadius="12">
                                    <Calendar x:Name="PART_Calendar" Width="270" Style="{StaticResource ActivityCalendar}" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityDateInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEF3FF" />
            <Setter Property="Background" Value="#101728" />
            <Setter Property="BorderBrush" Value="#37589F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#71A1FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#5781D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NetworkIpOptionTemplate">
            <StackPanel>
                <TextBlock Foreground="#d9e2ff" Text="{Binding InterfaceName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" FontFamily="Consolas" Foreground="#9ec1ff" Text="{Binding IpAddress}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LocalAccountOptionTemplate">
            <TextBlock Foreground="#eef3ff" Text="{Binding DisplayName}" />
        </DataTemplate>

        <Style x:Key="PortalCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6edff" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                x:Name="Box"
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="#0f1630"
                                BorderBrush="#486dbd"
                                BorderThickness="1"
                                CornerRadius="5">
                                <Path
                                    x:Name="Mark"
                                    Margin="4,2,0,0"
                                    Data="M 1 5 L 4 8 L 10 2"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6b95f7" />
                                <Setter TargetName="Box" Property="Background" Value="#15234b" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3d6ec8" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#76a3ff" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="0,15"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{StaticResource AccentBlue}" />
                                    <GradientStop Offset="1" Color="{StaticResource AccentPurple}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#222233" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2a2a3a" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border
                            x:Name="RootBd"
                            Background="#121525"
                            BorderBrush="#2a3350"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <ToggleButton
                                    x:Name="HeaderToggle"
                                    Margin="0"
                                    MinHeight="50"
                                    Padding="12,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    Focusable="False"
                                    IsTabStop="False"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                x:Name="HeaderBd"
                                                Background="Transparent"
                                                CornerRadius="14">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBd" Property="Background" Value="#151b30" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="HeaderBd" Property="Background" Value="#1a2139" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            TextElement.FontSize="16"
                                            TextElement.FontWeight="SemiBold"
                                            TextElement.Foreground="#eef3ff" />
                                        <Grid
                                            Grid.Column="2"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                            <TextBlock
                                                x:Name="ChevronDown"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="10"
                                                Foreground="#9fb0d9"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="&#xE70D;" />
                                            <TextBlock
                                                x:Name="ChevronRight"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="10"
                                                Foreground="#9fb0d9"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="&#xE76C;"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                </ToggleButton>

                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="14,6,14,14"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderToggle" Property="IsChecked" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RootBd" Property="BorderBrush" Value="#313c5d" />
                                <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ChevronRight" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger SourceName="HeaderToggle" Property="IsChecked" Value="False">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="RootBd" Property="BorderBrush" Value="#2a3350" />
                                <Setter TargetName="ChevronDown" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ChevronRight" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

