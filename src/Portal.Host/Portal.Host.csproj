<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Assets\portal-icon.ico</ApplicationIcon>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Portal.Host</RootNamespace>
        <AssemblyName>Portal.Host</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Assets\portal-icon.png" />
    </ItemGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="QRCoder" Version="1.6.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="System.Management" Version="9.0.8" />
        <ProjectReference Include="..\Portal.Common\Portal.Common.csproj" />
        <ProjectReference Include="..\Portal.CredentialProvider\Portal.CredentialProvider.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <OutputItemType></OutputItemType>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <Targets>Build</Targets>
        </ProjectReference>
        <ProjectReference Include="..\Portal.Updater\Portal.Updater.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <OutputItemType></OutputItemType>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <Targets>Build</Targets>
        </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <Authors>xXKoksMenXx</Authors>
        <Company>xXTeam</Company>
        <Product>Portal Host (Windows)</Product>
        <Copyright>Copyright © 2026</Copyright>
    </PropertyGroup>

    <Target Name="SignOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SkipSigning)' != 'true'">
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;F1A00AC831420B2AADEFD0BCCDFD99FDAF246D7B&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(TargetPath)&quot;" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;F1A00AC831420B2AADEFD0BCCDFD99FDAF246D7B&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(TargetDir)$(TargetName).exe&quot;" Condition="Exists('$(TargetDir)$(TargetName).exe')" />
    </Target>

    <Target Name="CopyCredentialProviderOutput" AfterTargets="Build;Publish">
        <ItemGroup>
            <CredentialProviderOutput Include="..\Portal.CredentialProvider\bin\$(Configuration)\$(TargetFramework)\*.*" />
            <CredentialProviderOutputRuntimes Include="..\Portal.CredentialProvider\bin\$(Configuration)\$(TargetFramework)\runtimes\**\*.*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(CredentialProviderOutput)"
            DestinationFolder="$(TargetDir)CredentialProvider"
            SkipUnchangedFiles="false"
            Condition="'$(PublishDir)' == ''"
            ContinueOnError="false" />
        <Copy
            SourceFiles="@(CredentialProviderOutputRuntimes)"
            DestinationFiles="@(CredentialProviderOutputRuntimes->'$(TargetDir)CredentialProvider\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="false"
            Condition="'$(PublishDir)' == ''"
            ContinueOnError="false" />
        <Copy
            SourceFiles="@(CredentialProviderOutput)"
            DestinationFolder="$(PublishDir)CredentialProvider"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' != ''" />
        <Copy
            SourceFiles="@(CredentialProviderOutputRuntimes)"
            DestinationFiles="@(CredentialProviderOutputRuntimes->'$(PublishDir)CredentialProvider\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' != ''" />
    </Target>

    <Target Name="CopyUpdaterOutput" AfterTargets="Build;Publish">
        <ItemGroup>
            <UpdaterOutput Include="..\Portal.Updater\bin\$(Configuration)\$(TargetFramework)\*.*" />
            <UpdaterOutputRuntimes Include="..\Portal.Updater\bin\$(Configuration)\$(TargetFramework)\runtimes\**\*.*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(UpdaterOutput)"
            DestinationFolder="$(TargetDir)Updater"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' == ''"
            ContinueOnError="true" />
        <Copy
            SourceFiles="@(UpdaterOutputRuntimes)"
            DestinationFiles="@(UpdaterOutputRuntimes->'$(TargetDir)Updater\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' == ''"
            ContinueOnError="true" />
        <Copy
            SourceFiles="@(UpdaterOutput)"
            DestinationFolder="$(PublishDir)Updater"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' != ''" />
        <Copy
            SourceFiles="@(UpdaterOutputRuntimes)"
            DestinationFiles="@(UpdaterOutputRuntimes->'$(PublishDir)Updater\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'$(PublishDir)' != ''" />
    </Target>

    <Target Name="CleanPublishRootDuplicates" BeforeTargets="SignPublishOutput" Condition="'$(PublishDir)' != ''">
        <Delete Files="$(PublishDir)Portal.CredentialProvider.comhost.dll;$(PublishDir)Portal.CredentialProvider.dll;$(PublishDir)Portal.CredentialProvider.deps.json;$(PublishDir)Portal.CredentialProvider.runtimeconfig.json;$(PublishDir)Portal.Updater.exe;$(PublishDir)Portal.Updater.dll;$(PublishDir)Portal.Updater.deps.json;$(PublishDir)Portal.Updater.runtimeconfig.json" />
    </Target>

    <Target Name="SignPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' And '$(SkipSigning)' != 'true'">
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;F1A00AC831420B2AADEFD0BCCDFD99FDAF246D7B&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)$(TargetName).dll&quot;" Condition="Exists('$(PublishDir)$(TargetName).dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;F1A00AC831420B2AADEFD0BCCDFD99FDAF246D7B&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)$(TargetName).exe&quot;" Condition="Exists('$(PublishDir)$(TargetName).exe')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;7492EFCAEAEFD328F405F05E0A6BCBF12402C7A8&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)Portal.Common.dll&quot;" Condition="Exists('$(PublishDir)Portal.Common.dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;6B757026547640EBCDB08ACFD568F2A873D601F0&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)Updater\Portal.Updater.exe&quot;" Condition="Exists('$(PublishDir)Updater\Portal.Updater.exe')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;6B757026547640EBCDB08ACFD568F2A873D601F0&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)Updater\Portal.Updater.dll&quot;" Condition="Exists('$(PublishDir)Updater\Portal.Updater.dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;7492EFCAEAEFD328F405F05E0A6BCBF12402C7A8&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)Updater\Portal.Common.dll&quot;" Condition="Exists('$(PublishDir)Updater\Portal.Common.dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;110025BF33D9D8EEE632AD6C4F43618A24069B22&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)CredentialProvider\Portal.CredentialProvider.comhost.dll&quot;" Condition="Exists('$(PublishDir)CredentialProvider\Portal.CredentialProvider.comhost.dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;110025BF33D9D8EEE632AD6C4F43618A24069B22&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)CredentialProvider\Portal.CredentialProvider.dll&quot;" Condition="Exists('$(PublishDir)CredentialProvider\Portal.CredentialProvider.dll')" />
        <Exec Command="call &quot;E:\Windows Kits\10\bin\10.0.26100.0\x86\signtool.exe&quot; sign /sha1 &quot;7492EFCAEAEFD328F405F05E0A6BCBF12402C7A8&quot; /tr http://timestamp.acs.microsoft.com /td sha256 /fd sha256 &quot;$(PublishDir)CredentialProvider\Portal.Common.dll&quot;" Condition="Exists('$(PublishDir)CredentialProvider\Portal.Common.dll')" />
    </Target>

</Project>
